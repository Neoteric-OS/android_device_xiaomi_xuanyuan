cc_binary {
    name: "vibratorfeature-wrapper",
    init_rc: ["vibratorfeature-wrapper.rc"],
    vintf_fragments: ["android.hardware.vibrator.xml"],
    relative_install_path: "hw",
    device_specific: true,
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.vibrator-V2-ndk",
    ],
    srcs: [
        "main.cpp",
        "VibratorWrapper.cpp",
    ],
}
