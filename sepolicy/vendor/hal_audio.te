allow hal_audio_default vendor_sysfs_vibrator:dir search;
allow hal_audio_default vendor_sysfs_vibrator:file r_file_perms;
allow hal_audio_default vendor_hal_ozonotify_hwservice:hwservice_manager find;
allow hal_audio_default vendor_hal_ozonotify_service:service_manager find;
allow hal_audio_default vendor_hal_ozonotify:binder { call transfer };
allow hal_audio_default vendor_hal_ozonotify:binder transfer;
allow hal_audio_default vendor_hal_ozonotify:fd *;

# Dontaudit Audio to read default_prop
hal_client_domain(hal_audio_default, vendor_hal_micharge_xiaomi)

