# Audio
allow vendor_hal_perf_default hal_audio_default:dir { search };

# Fingerprint
allow vendor_hal_perf_default hal_fingerprint_default:dir r_dir_perms;
allow vendor_hal_perf_default hal_fingerprint_default:file r_file_perms;

# Migt
allow vendor_hal_perf_default vendor_sysfs_migt_cpu_exclusive:file rw_file_perms;

# System server
allow vendor_hal_perf_default system_server:dir r_dir_perms;
allow vendor_hal_perf_default system_server:file r_file_perms;

